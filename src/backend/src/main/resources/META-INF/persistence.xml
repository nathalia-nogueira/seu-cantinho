<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="seuCantinhoPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>app.modelo.Usuario</class>
        <class>app.modelo.Cliente</class>
        <class>app.modelo.Administrador</class>
        <class>app.modelo.Espaco</class>
        <class>app.modelo.Reserva</class>
        <class>app.modelo.Pagamento</class>
        <class>app.modelo.Filial</class>
        <class>app.modelo.Endereco</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://db:5432/meu-banco"/>
            <property name="jakarta.persistence.jdbc.user" value="user"/>
            <property name="jakarta.persistence.jdbc.password" value="pass"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
